# Copiar a .env.local y completar. Nunca versionar .env.local.
# Los valores salen del panel de Supabase (Project Settings > API).

# Públicas: viajan al navegador. Es seguro que lleven el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: solo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres para Drizzle (solo servidor, secreta).
# En Supabase: Project Settings > Database > Connection string.
DATABASE_URL=
