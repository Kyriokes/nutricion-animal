# Copiar a .env.local y completar. Nunca versionar .env.local.
# Los valores salen del panel de Supabase (Project Settings > API keys).

# Públicas: viajan al navegador. Es seguro que lleven el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreta (sb_secret_...): solo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el código.
SUPABASE_SECRET_KEY=

# Conexión a Postgres para Drizzle (solo servidor, secreta). Lleva la contraseña de la base.
# En Supabase: botón Connect > Session pooler (puerto 5432, funciona con IPv4).
DATABASE_URL=

# Opcional. Pago de prueba (aprobar o rechazar sin cobrar) mientras no esté Mercado Pago.
# En desarrollo siempre está activo; en producción solo con "true" (por ejemplo, una demo).
PAYMENTS_SIMULATED=
